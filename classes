<div class="center-container">
    <div class="card">
        <h2 class="mb-4">Image Prediction</h2>

        {% with messages = get_flashed_messages() %}
        {% if messages %}
        <div class="alert alert-warning">
            {% for msg in messages %}<p class="mb-0">{{ msg }}</p>{% endfor %}
        </div>
        {% endif %}
        {% endwith %}

        <form method="POST" enctype="multipart/form-data">
            <input class="form-control" type="file" name="file" accept="image/*" required>
            <select class="form-select" name="model_choice" required>
                <option value="" disabled selected>Select Model</option>
                {% for model in models %}
                    <option value="{{ model }}" {% if model_choice==model %}selected{% endif %}>{{ model }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn btn-success mt-2">Predict</button>
        </form>

        {% if filename %}
        <img src="{{ url_for('uploaded_file', filename=filename) }}" class="uploaded-image" alt="Uploaded Image">
        {% if prediction %}
        <div class="prediction"><strong>Prediction:</strong> {{ prediction }}</div>
        {% endif %}
        {% endif %}

        <a href="{{ url_for('history') }}" class="btn btn-primary">View History</a>
    </div>
</div>

